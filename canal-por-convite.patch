+  // Consulta um canal pelo convite (só leitura) e devolve o JID @newsletter.
+  public async fetchChannelByInvite(invite: string) {
+    const code = String(invite ?? '')
+      .trim()
+      .replace(/^https?:\/\/(www\.)?whatsapp\.com\/channel\//i, '')
+      .split(/[/?#]/)[0];
+    if (!/^[A-Za-z0-9_-]{10,64}$/.test(code)) {
+      throw new BadRequestException('Invalid channel invite code');
+    }
+    let meta: any;
+    try {
+      meta = await this.client.newsletterMetadata('invite', code);
+    } catch (error) {
+      this.logger.error(`fetchChannelByInvite failed: ${error?.message ?? error}`);
+      throw new BadRequestException('Channel lookup failed');
+    }
+    if (!meta?.id || !String(meta.id).endsWith('@newsletter')) {
+      throw new NotFoundException('Channel not found');
+    }
+    // O Baileys devolve a resposta crua do WhatsApp: nome e descrição ficam em thread_metadata.*.text.
+    const thread = meta.thread_metadata ?? {};
+    return {
+      id: meta.id,
+      name: meta.name ?? thread.name?.text ?? null,
+      description: meta.description ?? thread.description?.text ?? null,
+      subscribers: Number(meta.subscribers ?? thread.subscribers_count ?? 0) || null,
+    };
+  }
+
